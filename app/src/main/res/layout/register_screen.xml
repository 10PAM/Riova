<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/black"
    tools:context=".activities.RegisterActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/icon_view"
            android:backgroundTint="@null"
            android:contentDescription="@string/riova_icon"
            android:src="@mipmap/ic_launcher_foreground"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="@string/create_your_account"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginVertical="10dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="400dp"
                android:layout_height="100dp"
                android:background="@color/login_back"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:contentDescription="@string/nickname_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:foregroundGravity="center"
                    android:src="@drawable/nickname"
                    android:scaleType="fitCenter"/>

                <EditText
                    android:id="@+id/input_nickname"
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:hint="@string/nickname_optional"
                    android:textAlignment="center"
                    android:inputType="textPersonName"
                    android:textColor="@color/white"
                    android:autofillHints="none"
                    android:textColorHint="@color/white"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="400dp"
                android:layout_height="100dp"
                android:background="@color/login_back"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:contentDescription="@string/email_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:foregroundGravity="center"
                    android:src="@drawable/email" />

                <EditText
                    android:id="@+id/input_email"
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:textAlignment="center"
                    android:autofillHints="none"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="400dp"
                android:layout_height="100dp"
                android:background="@color/login_back"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:contentDescription="@string/password_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:foregroundGravity="center"
                    android:src="@drawable/lock" />

                <EditText
                    android:id="@+id/input_password"
                    android:layout_width="350dp"
                    android:layout_height="match_parent"
                    android:hint="@string/password"
                    android:autofillHints="none"
                    android:inputType="textPassword"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textColor="@color/warning"
            android:gravity="center"
            android:textStyle="bold"
            />

        <Button
            android:id="@+id/button_register"
            style="@style/login_buttons"
            android:text="@string/register"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/or"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_registerbacktologin"
            style="@style/login_buttons"
            android:text="@string/back_text"
            app:backgroundTint="@null" />

    </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>