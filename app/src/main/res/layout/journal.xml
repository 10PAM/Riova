<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_journal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigation_back"
    tools:context=".activities.JournalFragment">

    <!--Content Start-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/journal_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="5dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="vertical"
        android:fillViewport="true">

    </androidx.recyclerview.widget.RecyclerView>

    <Button
        android:id="@+id/button_addJournal"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:text="@string/plus"
        android:textSize="40sp"
        app:backgroundTint="@null"
        style="@style/addjournal_button"/>
    <!--Content End-->

</androidx.coordinatorlayout.widget.CoordinatorLayout>