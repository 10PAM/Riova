<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_journal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigation_back"
    tools:context=".fragments.JournalFragment">

    <!--Content Start-->
    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/journal_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="5dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="vertical"
        app:stackFromEnd="false"
        android:scrollbars="vertical"
        android:scrollbarTrackVertical="@color/black"
        android:fillViewport="true">

    </androidx.recyclerview.widget.RecyclerView>

    <Button
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/button_addJournal"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="@string/plus"
        android:textSize="25sp"
        app:backgroundTint="@null"
        style="@style/addjournal_button"
        android:layout_margin="10dp"/>
    <!--Content End-->

</androidx.constraintlayout.widget.ConstraintLayout>