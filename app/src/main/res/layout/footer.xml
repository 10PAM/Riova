<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--Navigation Menu-->
    <LinearLayout
        android:layout_margin="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/footer_back"
        android:id="@+id/header_layout">

        <!--Journal Start-->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:contentDescription="@string/journal"
                android:id="@+id/button_journal"
                android:src=""
                app:backgroundTint="@null"
                style="@style/nav_button"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="15sp"
                android:textColor="@color/white"/>

        </LinearLayout>
        <!--Journal End-->

        <!--Mindfullness Start-->
        <ImageButton
            android:contentDescription="@string/mindfullness"
            android:id="@+id/button_mindfullness"
            android:src=""
            app:backgroundTint="@null"
            style="@style/nav_button"/>
        <!--Mindfullness End-->

        <!--Dashboard Start-->
        <ImageButton
            android:contentDescription="@string/dashboard"
            android:id="@+id/button_dashboard"
            android:src="@drawable/ic_action_name"
            app:backgroundTint="@null"
            style="@style/nav_button"/>

        <!--Dashboard End-->
        <!--Meditation Start-->
        <ImageButton
            android:contentDescription="@string/meditation"
            android:id="@+id/button_meditation"
            android:src=""
            app:backgroundTint="@null"
            style="@style/nav_button"/>
        <!--Meditation End-->

        <!--General Wellness Start-->
        <ImageButton
            android:contentDescription="@string/general_wellness"
            android:id="@+id/button_generalWellness"
            android:src=""
            app:backgroundTint="@null"
            style="@style/nav_button"/>
        <!--Meditation End-->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>