<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--Navigation Menu-->
    <LinearLayout
        android:layout_margin="0dp"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/footer_back"
        android:id="@+id/header_layout">

        <!--Journal Start-->
        <LinearLayout
            style="@style/nav_button_linear_layout">
            <ImageButton
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/journal"
                android:id="@+id/button_journal"
                android:src="@drawable/ic_action_inactive_button"
                app:backgroundTint="@null"
                style="@style/nav_button"/>
            <TextView
                style="@style/nav_button_text"
                android:text="Journal"/>
        </LinearLayout>
        <!--Journal End-->

        <!--Mindfulness Start-->
        <LinearLayout
            style="@style/nav_button_linear_layout">

            <ImageButton
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mindfulness"
                android:id="@+id/button_mindfullness"
                android:src="@drawable/ic_action_inactive_button"
                app:backgroundTint="@null"
                style="@style/nav_button"/>
            <TextView
                style="@style/nav_button_text"
                android:text="Mindful"/>
        </LinearLayout>
        <!--Mindfulness End-->

        <!--Dashboard Start-->
        <LinearLayout
            style="@style/nav_button_linear_layout">
            <ImageButton
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/dashboard"
                android:id="@+id/button_dashboard"
                android:src="@drawable/ic_action_name"
                app:backgroundTint="@null"
                style="@style/nav_button"/>
            <TextView
                style="@style/nav_button_text"
                android:text="Dashboard"/>
        </LinearLayout>
        <!--Dashboard End-->

        <!--Meditation Start-->
        <LinearLayout
            style="@style/nav_button_linear_layout">
            <ImageButton
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/meditation"
                android:id="@+id/button_meditation"
                android:src="@drawable/ic_action_inactive_button"
                app:backgroundTint="@null"
                style="@style/nav_button"/>
            <TextView
                style="@style/nav_button_text"
                android:text="Meditation"/>
        </LinearLayout>
        <!--Meditation End-->

        <!--General Wellness Start-->
        <LinearLayout
            style="@style/nav_button_linear_layout">
            <ImageButton
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/general_wellness"
                android:src="@drawable/ic_action_inactive_button"
                app:backgroundTint="@null"
                style="@style/nav_button"/>
            <TextView
                style="@style/nav_button_text"
                android:text="Gen Well"/>
        </LinearLayout>
        <!--Meditation End-->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>