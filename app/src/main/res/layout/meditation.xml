<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_meditation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigation_back"
    tools:context=".fragments.MeditationFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/meditation_sounds_ambience"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/meditation_sound_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:divider="@color/journalPreview_back"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@color/journalPreview_back"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/meditation_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/navigation_back"
                android:paddingHorizontal="14dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white"
                android:textSize="72sp"
                tools:text="00:00" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/meditation_duration_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meditation_duration"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/meditation_duration_input"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:autofillHints=""
                    android:backgroundTint="@color/white"
                    android:gravity="center"
                    android:hint="@string/meditation_minutes_hint"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:minHeight="48dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/meditation_start_pause_button"
                    style="@style/dashboard_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/meditation_start" />

                <Button
                    android:id="@+id/meditation_stop_button"
                    style="@style/dashboard_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/meditation_stop" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <!--Content End-->

</androidx.coordinatorlayout.widget.CoordinatorLayout>